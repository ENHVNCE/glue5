 }
 
+/// glue5: records, before a render pass begins, the barriers for what it
+/// uses: its attachments, and the bind groups, vertex and index buffers its
+/// commands set (the caller made sure nothing else adds a usage). Returns
+/// whether it did; it records nothing if a usage conflicts (the pass's own
+/// encoding then reports the error).
+fn barriers_before_begin(
+    device: &Arc<Device>,
+    raw: &mut dyn hal::DynCommandEncoder,
+    tracker: &mut Tracker,
+    attachments: &[RenderAttachment],
+    commands: &[ArcRenderCommand],
+    snatch_guard: &SnatchGuard,
+) -> bool {
+    let mut scope = device.new_usage_scope();
+    for ra in attachments {
+        if unsafe { scope.textures.merge_single(&ra.texture, Some(ra.selector.clone()), ra.usage) }.is_err() {
+            return false;
+        }
+    }
+    for command in commands {
+        let merged = match command {
+            ArcRenderCommand::SetBindGroup { bind_group: Some(group), .. } => unsafe { scope.merge_bind_group(&group.used) },
+            ArcRenderCommand::SetIndexBuffer { buffer, .. } => scope.buffers.merge_single(buffer, wgt::BufferUses::INDEX),
+            ArcRenderCommand::SetVertexBuffer { buffer: Some(buffer), .. } => scope.buffers.merge_single(buffer, wgt::BufferUses::VERTEX),
+            _ => Ok(()),
+        };
+        if merged.is_err() {
+            return false;
+        }
+    }
+    let indices = &device.tracker_indices;
+    tracker.buffers.set_size(indices.buffers.size());
+    tracker.textures.set_size(indices.textures.size());
+    CommandEncoder::insert_barriers_from_scope(raw, tracker, &scope, snatch_guard);
+    true
+}
